# Copia este archivo como .env.local para desarrollo local (nunca subas el
# de verdad — .gitignore ya excluye .env y .env.local). En producción, estas
# mismas claves van en Vercel → Project → Settings → Environment Variables.
#
# Mientras falte SUPABASE_URL/SUPABASE_SERVICE_ROLE_KEY, la web funciona en
# "modo demo": simula las reservas sin guardar nada de verdad.

# Supabase — Project Settings → API. OJO: la "service_role" key, NO la "anon".
# Esa clave puede saltarse todas las reglas de seguridad: solo vive aquí, en
# el servidor, nunca en el código del navegador.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Google Calendar — ver scripts/autorizar-google.mjs para conseguir estos valores.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# El ID del calendario donde se crean las citas (no tu email personal si has
# creado uno dedicado: Ajustes del calendario → "ID de calendario").
GOOGLE_CALENDAR_ID=primary

# Resend (email de confirmación) — resend.com → API Keys.
RESEND_API_KEY=
RESEND_FROM=Óptica Claravista <onboarding@resend.dev>

# URL pública del sitio (para construir el enlace de "gestiona tu cita").
APP_BASE_URL=https://optica-claravista.vercel.app

# Teléfono que se muestra cuando ya no se puede cambiar/cancelar por la web
# (menos de 12h). Es solo texto, no envía nada.
TELEFONO_CONTACTO=[teléfono]

# Chatbot con IA — Google AI Studio (aistudio.google.com) → Get API key.
# Sin esto, el asistente sigue apareciendo pero avisa de que no está conectado.
GEMINI_API_KEY=
